{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Edit(.env)",
      "Write(.env)",
      "Bash(cat .env*)",
      "Bash(less .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(grep * .env)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(*shortbot-admin*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ],
    "allow": [
      "mcp__shortbot",
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch",
      "Bash(.venv/bin/shortbot *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/python *)",
      "Bash(PYTHONPATH=src .venv/bin/*)",
      "Bash(uv *)",
      "Bash(git *)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && .venv/bin/shortbot brief 2>/dev/null || echo 'shortbot brief unavailable'",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
