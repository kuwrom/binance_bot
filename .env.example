# demo = Binance Demo Trading (demo-fapi.binance.com, fake money). live = real money.
SHORTBOT_MODE=demo
# Required to switch to live mode (exact phrase):
# LIVE_CONFIRM=I_ACCEPT_REAL_MONEY_RISK

# Demo keys: https://demo.binance.com  -> API Management (futures demo)
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
# Live keys: enable Futures, restrict to your server IP, NEVER enable withdrawals
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

SHORTBOT_DB=data/shortbot.db

# Journal backups: `shortbot backup` (schedule, off-box and restore: deploy/DEPLOY.md, section 7)
SHORTBOT_BACKUP_DIR=data/backups
SHORTBOT_BACKUP_KEEP_DAILY=7
SHORTBOT_BACKUP_KEEP_WEEKLY=4
# Off-box copy (optional, unset = local copies only): a command run once per new file, without a shell.
# {file} = absolute path, {name} = file name. Credentials stay in the tool's own config
# (EC2 instance role, ~/.aws, rclone config), never here. Pick one:
# SHORTBOT_BACKUP_OFFBOX=aws s3 cp {file} s3://<bucket>/shortbot/{name}
# SHORTBOT_BACKUP_OFFBOX=rclone copyto {file} <remote>:shortbot/{name}
# SHORTBOT_BACKUP_OFFBOX=cp {file} /Volumes/<disk>/shortbot/{name}

# Guardian alerts (optional): create a bot with @BotFather, get chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# BASELINE risk limits (enforced in code; defaults shown). The AWS guardian always uses exactly these.
# The AI analyst may override any of them for research via set_risk_params (demo only), within the bounds below.
MAX_LEVERAGE=3
MAX_POSITION_NOTIONAL=100
MAX_TOTAL_NOTIONAL=400
MAX_POSITIONS=5
RISK_PER_TRADE_PCT=1.0
DAILY_LOSS_LIMIT_PCT=3.0
MIN_STOP_DISTANCE_PCT=0.5
MAX_STOP_DISTANCE_PCT=25
MIN_QUOTE_VOLUME_24H=20000000
# Stop must trigger at least this % before the estimated liquidation price
LIQ_BUFFER_PCT=2.0

# RESEARCH BOUNDS (human-only): the range the AI may set each limit to. Defaults shown; uncomment to change.
# BOUND_MAX_LEVERAGE_MIN=1
# BOUND_MAX_LEVERAGE_MAX=10
# BOUND_MAX_POSITION_NOTIONAL_MAX=1000
# BOUND_MAX_TOTAL_NOTIONAL_MAX=4000
# BOUND_MAX_POSITIONS_MAX=10
# BOUND_RISK_PER_TRADE_PCT_MAX=3.0
# BOUND_DAILY_LOSS_LIMIT_PCT_MAX=10.0
# BOUND_MAX_STOP_DISTANCE_PCT_MAX=50
# BOUND_MIN_QUOTE_VOLUME_24H_MIN=1000000
# Allow AI research overrides in LIVE mode too (default false: live uses the baseline only)
AI_PARAMS_IN_LIVE=false
